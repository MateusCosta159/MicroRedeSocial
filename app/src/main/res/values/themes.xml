<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.Triply" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#0077B6</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#E0F4FF</item>
        <item name="colorOnPrimaryContainer">#002D45</item>
        <item name="colorSecondary">#0096C7</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorTertiary">#48CAE4</item>
        <item name="android:statusBarColor">@color/primary</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

    <style name="Theme.Triply" parent="Base.Theme.Triply" />

    <style name="Theme.Triply.Splash" parent="Theme.Triply">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:statusBarColor">#0077B6</item>
        <item name="android:navigationBarColor">#0077B6</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="ShapeAppearance.Material3.Corner.Full" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="ShapeAppearance.Material3.Medium" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

</resources>